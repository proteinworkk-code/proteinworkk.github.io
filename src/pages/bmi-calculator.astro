<script>
  (function () {
    const $ = (i: string) => document.getElementById(i);
    const U = () => (document.querySelector('[name=u]:checked') as HTMLInputElement).value;
    const S = () => (document.querySelector('[name=s]:checked') as HTMLInputElement).value;

    const MIN = 12;
    const MAX = 40;

    interface ScaleBand {
      min: number;
      max: number;
      cls: string;
    }

    const SCALE: Record<string, ScaleBand[]> = {
      in: [
        { min: MIN, max: 18.5, cls: 's0' },
        { min: 18.5, max: 23, cls: 's1' },
        { min: 23, max: 25, cls: 's2' },
        { min: 25, max: MAX, cls: 's3' },
      ],
      int: [
        { min: MIN, max: 18.5, cls: 's0' },
        { min: 18.5, max: 25, cls: 's1' },
        { min: 25, max: 30, cls: 's2' },
        { min: 30, max: MAX, cls: 's3' },
      ],
    };

    function cat(b: number, s: string): { label: string; text: string; badgeCls: string } {
      if (b < 18.5) {
        return {
          label: 'Underweight (< 18.5)',
          text: 'A BMI below 18.5 is below the reference range. It can have many causes, so it is worth discussing with a doctor or dietitian, especially if it is unexpected.',
          badgeCls: 'cat-badge--underweight',
        };
      }
      if (s === 'in') {
        if (b < 23) {
          return {
            label: 'Healthy Weight (18.5 – 22.9)',
            text: 'Your BMI falls in the reference range for Indian adults. Waist size, strength and energy still matter for a full picture.',
            badgeCls: 'cat-badge--normal',
          };
        }
        if (b < 25) {
          return {
            label: 'Increased Risk (23.0 – 24.9)',
            text: 'This band signals increased risk for Indian adults. It is not a diagnosis. Measuring your waist and discussing it with a doctor or certified coach is a sensible next step.',
            badgeCls: 'cat-badge--overweight',
          };
        }
        return {
          label: 'Indian Obesity Threshold (≥ 25.0)',
          text: 'This is at or above the 2009 Indian BMI threshold. BMI alone cannot diagnose anything, so check your waist and speak to a healthcare professional for proper assessment.',
          badgeCls: 'cat-badge--obesity',
        };
      } else {
        if (b < 25) {
          return {
            label: 'Healthy Weight (18.5 – 24.9)',
            text: 'Your BMI falls in the conventional healthy range. Waist size, strength and fitness still add useful context.',
            badgeCls: 'cat-badge--normal',
          };
        }
        if (b < 30) {
          return {
            label: 'Overweight Range (25.0 – 29.9)',
            text: 'This is the conventional overweight band. Muscle mass can raise BMI, so look at waist size and other measures before drawing conclusions.',
            badgeCls: 'cat-badge--overweight',
          };
        }
        return {
          label: 'Obesity Range (≥ 30.0)',
          text: 'This is in the conventional obesity band. BMI is a screening result, not a diagnosis. Please speak to a healthcare professional for proper assessment.',
          badgeCls: 'cat-badge--obesity',
        };
      }
    }

    function renderBar(s: string) {
      let h = '';
      SCALE[s].forEach((x) => {
        const widthPct = ((x.max - x.min) / (MAX - MIN)) * 100;
        h += `<span class="${x.cls}" style="width:${widthPct}%"></span>`;
      });
      const bEl = $('b');
      if (bEl) bEl.innerHTML = `${h}<i class="mk" id="mk" style="left:0"></i>`;

      const scEl = $('sc');
      if (scEl) {
        const ticks = s === 'in' ? ['18.5', '23.0', '25.0'] : ['18.5', '25.0', '30.0'];
        scEl.innerHTML = ticks.map((t) => `<span>${t}</span>`).join('');
      }
    }

    function num(id: string): number {
      const el = $(id) as HTMLInputElement;
      if (!el) return NaN;
      const v = el.value.trim();
      return v === '' ? NaN : Number(v);
    }

    function show(m: { kg: number; meters: number }, b: number, s: string) {
      const c = cat(b, s);
      const ph = $('ph');
      const out = $('out');
      if (ph) ph.hidden = true;
      if (out) out.hidden = false;

      const vEl = $('v');
      const cEl = $('c');
      const exEl = $('ex');
      const howEl = $('how');

      if (vEl) vEl.textContent = b.toFixed(1);
      if (cEl) {
        cEl.textContent = c.label;
        cEl.className = `cat-badge ${c.badgeCls}`;
      }
      if (exEl) exEl.textContent = c.text;
      if (howEl) {
        howEl.textContent = `Calculation: ${m.kg.toFixed(1)} kg ÷ (${m.meters.toFixed(3)} m)² = ${b.toFixed(1)} kg/m². Standard: ${s === 'in' ? 'Indian adult consensus.' : 'International (WHO).'}`;
      }

      // Calculate target healthy weight range
      const minHealthyBmi = 18.5;
      const maxHealthyBmi = s === 'in' ? 22.9 : 24.9;
      const minKg = minHealthyBmi * (m.meters * m.meters);
      const maxKg = maxHealthyBmi * (m.meters * m.meters);

      const idealText = $('ideal-text');
      if (idealText) {
        if (U() === 'm') {
          idealText.textContent = `${minKg.toFixed(1)} kg – ${maxKg.toFixed(1)} kg (${s === 'in' ? 'Indian consensus' : 'WHO standard'})`;
        } else {
          const minLb = minKg / 0.45359237;
          const maxLb = maxKg / 0.45359237;
          idealText.textContent = `${minLb.toFixed(0)} lb – ${maxLb.toFixed(0)} lb (${s === 'in' ? 'Indian consensus' : 'WHO standard'})`;
        }
      }

      // Update WhatsApp link text
      const waBtn = $('wa-cta-btn') as HTMLAnchorElement;
      if (waBtn) {
        const msg = `Hi Proteinworkk! I calculated my BMI as ${b.toFixed(1)} (${c.label}) on your website and would like to learn more about coaching options.`;
        waBtn.href = `https://wa.me/919831153184?text=${encodeURIComponent(msg)}`;
      }

      renderBar(s);
      const p = Math.min(100, Math.max(0, ((b - MIN) / (MAX - MIN)) * 100));
      requestAnimationFrame(() => {
        const mk = $('mk');
        if (mk) mk.style.left = `${p}%`;
      });
    }

    function calc(e?: Event) {
      if (e) e.preventDefault();
      let kg = 0;
      let meters = 0;
      let err = '';

      if (U() === 'm') {
        kg = num('kg');
        meters = num('cm') / 100;
        if (isNaN(kg) || isNaN(meters)) err = 'Enter both weight (kg) and height (cm).';
        else if (kg <= 0 || meters <= 0) err = 'Values must be greater than zero.';
        else if (kg < 20 || kg > 300) err = 'Weight should be between 20 and 300 kg.';
        else if (meters < 1 || meters > 2.5) err = 'Height should be between 100 and 250 cm.';
      } else {
        const lb = num('lb');
        const ft = num('ft');
        const innEl = $('in') as HTMLInputElement;
        const innVal = innEl && innEl.value.trim() === '' ? 0 : num('in');

        if (isNaN(lb) || isNaN(ft) || isNaN(innVal)) err = 'Enter weight, feet and inches (inches can be 0).';
        else if (lb <= 0 || ft <= 0 || innVal < 0) err = 'Values must be positive.';
        else if (innVal >= 12) err = 'Inches should be less than 12.';
        else {
          kg = lb * 0.45359237;
          meters = (ft * 12 + innVal) * 0.0254;
          if (kg < 20 || kg > 300) err = 'Weight should be between 44 and 660 lb.';
          else if (meters < 1 || meters > 2.5) err = 'Height should be between 3 ft 4 in and 8 ft 2 in.';
        }
      }

      const errEl = $('err');
      if (errEl) errEl.textContent = err;

      if (err) {
        const out = $('out');
        const ph = $('ph');
        if (out) out.hidden = true;
        if (ph) ph.hidden = false;
        return;
      }

      show({ kg, meters }, kg / (meters * meters), S());
    }

    function reset() {
      const f = $('f') as HTMLFormElement;
      if (f) f.reset();
      const err = $('err');
      if (err) err.textContent = '';
      const out = $('out');
      const ph = $('ph');
      if (out) out.hidden = true;
      if (ph) ph.hidden = false;
      toggle();
    }

    function toggle() {
      const isImp = U() === 'i';
      const mFields = $('metric-fields');
      const iFields = $('imp-fields');
      if (mFields) mFields.hidden = isImp;
      if (iFields) iFields.hidden = !isImp;
      const err = $('err');
      if (err) err.textContent = '';
    }

    const form = $('f');
    if (form) form.addEventListener('submit', calc);
    const rsBtn = $('rs');
    if (rsBtn) rsBtn.addEventListener('click', reset);

    document.querySelectorAll('[name=u]').forEach((r) => {
      r.addEventListener('change', () => {
        toggle();
        const out = $('out');
        const ph = $('ph');
        if (out) out.hidden = true;
        if (ph) ph.hidden = false;
      });
    });

    document.querySelectorAll('[name=s]').forEach((r) => {
      r.addEventListener('change', () => {
        const out = $('out');
        if (out && !out.hidden) calc();
      });
    });
  })();
</script>
