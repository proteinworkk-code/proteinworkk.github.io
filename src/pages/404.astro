---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { ROUTES } from '../config/routes';

const route = {
  path: '/404/',
  name: 'Page not found',
  title: 'Page not found | Proteinworkk',
  description: 'This page could not be found. Explore Proteinworkk’s online personal training and group programs.',
  indexable: false,
};
---
<BaseLayout route={route}>
  <Section tone="light">
    <h1>We could not find that page</h1>
    <p class="lede">The link may be old or mistyped. These pages will get you back on track.</p>
    <p style="display:flex;gap:.75rem;flex-wrap:wrap">
      <Button href={ROUTES.home.path} variant="primary">Go to the homepage</Button>
      <Button href={ROUTES.contact.path} variant="secondary">Contact Proteinworkk</Button>
    </p>
  </Section>
</BaseLayout>
