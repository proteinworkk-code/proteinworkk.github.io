---
/**
 * Global Floating WhatsApp Button & Optional Welcome Tooltip
 *
 * Configured for Proteinworkk (+91 9831153184) with a pre-filled enquiry message.
 * Rendered globally in BaseLayout so it is available across all pages.
 */
import { WHATSAPP } from '../config/site';

interface Props {
  /** Optional custom message overriding the default welcome text */
  message?: string;
  /** Optional custom tooltip text */
  tooltipText?: string;
}

const {
  message = WHATSAPP.defaultMessage,
  tooltipText = 'Need help choosing the right product? Chat with us!',
} = Astro.props;

const chatUrl = WHATSAPP.buildUrl(message);
---

<aside class="whatsapp-widget" aria-label="WhatsApp Contact">
  <!-- Desktop Welcome Tooltip / Bubble -->
  <div class="whatsapp-bubble" id="whatsapp-bubble" role="status">
    <a
      href={chatUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="whatsapp-bubble__link"
      data-cta="whatsapp"
      data-cta-location="tooltip"
    >
      <span class="whatsapp-bubble__text">{tooltipText}</span>
    </a>
    <button
      type="button"
      id="whatsapp-bubble-close"
      class="whatsapp-bubble__close"
      aria-label="Dismiss message"
      title="Dismiss"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Floating Action Button -->
  <a
    href={chatUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-fab"
    id="whatsapp-fab"
    aria-label="Chat with Proteinworkk on WhatsApp"
    title="Chat with us on WhatsApp"
    data-cta="whatsapp"
    data-cta-location="floating"
  >
    <svg
      class="whatsapp-fab__icon"
      viewBox="0 0 24 24"
      width="32"
      height="32"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.888 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.456 5.711 1.457h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
    <span class="visually-hidden">Chat with us on WhatsApp</span>
  </a>
</aside>

<style>
  .whatsapp-widget {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 95;
    display: flex;
    align-items: center;
    gap: 12px;
    pointer-events: none;
  }

  /* Message Bubble */
  .whatsapp-bubble {
    pointer-events: auto;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    color: #141610;
    padding: 10px 14px;
    border-radius: 14px;
    box-shadow: 0 4px 18px rgba(20, 22, 16, 0.14), 0 1px 3px rgba(20, 22, 16, 0.08);
    border: 1px solid rgba(32, 41, 27, 0.14);
    font-size: 0.88rem;
    font-weight: 550;
    line-height: 1.35;
    max-width: 250px;
    user-select: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .whatsapp-bubble[hidden] {
    display: none !important;
  }

  /* Pointer triangle pointing towards the FAB */
  .whatsapp-bubble::after {
    content: '';
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: #ffffff;
    border-top: 1px solid rgba(32, 41, 27, 0.14);
    border-right: 1px solid rgba(32, 41, 27, 0.14);
  }

  .whatsapp-bubble__link {
    color: inherit;
    text-decoration: none;
    display: block;
    cursor: pointer;
  }

  .whatsapp-bubble__link:hover {
    color: #20ba5a;
  }

  .whatsapp-bubble__close {
    background: transparent;
    border: none;
    padding: 4px;
    margin-left: 2px;
    color: #556048;
    cursor: pointer;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    flex-shrink: 0;
  }

  .whatsapp-bubble__close:hover {
    color: #141610;
    background: rgba(32, 41, 27, 0.08);
  }

  .whatsapp-bubble__close:focus-visible {
    outline: 2px solid #20291b;
  }

  /* Floating Action Button */
  .whatsapp-fab {
    pointer-events: auto;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background-color: #25d366;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18), 0 2px 6px rgba(37, 211, 102, 0.28);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease, background-color 0.2s ease;
    text-decoration: none;
    cursor: pointer;
    flex-shrink: 0;
  }

  .whatsapp-fab:hover {
    background-color: #20ba5a;
    color: #ffffff;
    transform: scale(1.08);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.24), 0 4px 10px rgba(37, 211, 102, 0.38);
  }

  .whatsapp-fab:focus-visible {
    outline: 3px solid #20291b;
    outline-offset: 3px;
  }

  .whatsapp-fab__icon {
    width: 32px;
    height: 32px;
    display: block;
  }

  /* Responsive Mobile Tweaks */
  @media (max-width: 768px) {
    .whatsapp-widget {
      right: calc(16px + env(safe-area-inset-right, 0px));
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    }

    .whatsapp-fab {
      width: 54px;
      height: 54px;
    }

    .whatsapp-fab__icon {
      width: 30px;
      height: 30px;
    }

    /* On mobile, keep the screen clean by hiding the bubble text */
    .whatsapp-bubble {
      display: none !important;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab,
    .whatsapp-bubble {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    try {
      const bubble = document.getElementById('whatsapp-bubble');
      const closeBtn = document.getElementById('whatsapp-bubble-close');
      if (!bubble || !closeBtn) return;

      // Keep dismissed across page navigations in the current session
      if (sessionStorage.getItem('pw_wa_dismissed') === '1') {
        bubble.hidden = true;
        return;
      }

      closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        bubble.hidden = true;
        try {
          sessionStorage.setItem('pw_wa_dismissed', '1');
        } catch {}
      });
    } catch {}
  })();
</script>
