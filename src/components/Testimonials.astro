---
/** Renders nothing unless genuine, consented stories exist in src/data/testimonials.ts. */
import Section from './Section.astro';
import { testimonials } from '../data/testimonials';
const items = testimonials.filter((t) => t.consented);
---
{items.length > 0 && (
  <Section id="member-stories" tone="tint" labelledby="stories-title">
    <h2 id="stories-title">Member stories</h2>
    <p class="muted">Real people. Consistent effort. Personal progress.</p>
    <div class="people">
      {items.map((t) => (
        <figure class="story">
          <blockquote><p>{t.quote}</p></blockquote>
          <figcaption>{t.name}{t.detail ? `, ${t.detail}` : ''}</figcaption>
        </figure>
      ))}
    </div>
  </Section>
)}
