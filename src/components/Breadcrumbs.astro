---
import type { Crumb } from '../config/routes';
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <li>
        {i < items.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
