# Copy this file to .env for local work. For GitHub Actions, set these as repository
# *Variables* (Settings > Secrets and variables > Actions > Variables). None of these are secrets:
# they end up in the public site by design.

# Canonical domain, no trailing slash. Assumed from the contact email; verify before launch.
PUBLIC_SITE_URL=https://proteinworkk.com

# Enquiry form endpoint, e.g. a Formspree form URL: https://formspree.io/f/xxxxxxxx
# Leave blank until you have created one. While blank, the form tells visitors it is not connected
# and offers an email fallback instead of pretending to send.
PUBLIC_FORM_ENDPOINT=

# Google Analytics 4 measurement ID
PUBLIC_GA4_ID=G-PDHH0XQZK2
